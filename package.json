{
	"name": "klarna-payments-for-woocommerce",
	"private": true,
	"scripts": {
		"build": "wp-scripts build --config webpack.config.cjs && composer i18n",
		"start": "wp-scripts start --config webpack.config.cjs",
		"lint": "npm run lint:js && npm run lint:css",
		"typecheck": "tsc --noEmit",
		"lint:js": "wp-scripts lint-js blocks/src assets/js src --ignore-pattern \"**/*.min.js\"",
		"lint:css": "wp-scripts lint-style \"blocks/src/**/*.{css,scss}\" \"assets/css/**/*.css\" \"src/**/assets/css/*.css\" --ignore-pattern \"**/*.min.css\" --allow-empty-input",
		"playground:start": "node tools/playground.mjs start",
		"playground:server-development": "node tools/playground.mjs server development",
		"playground:server-demo": "node tools/playground.mjs server demo",
		"playground:setup": "node tools/playground.mjs setup",
		"screenshots": "node tools/playground.mjs screenshots"
	},
	"devDependencies": {
		"@krokedil/wp-playground-tools": "github:krokedil/wp-playground-tools#semver:^1",
		"@types/react": "^18.3.31",
		"@woocommerce/dependency-extraction-webpack-plugin": "^5.1.0",
		"@wordpress/prettier-config": "^5.0.0",
		"@wordpress/scripts": "^37.0.0",
		"allure": "^3.14.3",
		"glob": "^13.0.0",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"prettier": "@wordpress/prettier-config"
}
