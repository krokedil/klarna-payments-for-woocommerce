# Based on the WooCommerce .gitattributes file: https://github.com/woocommerce/woocommerce/blob/trunk/.gitattributes
*       text=auto

# Force LF In Configuration Files
*.md    text    eol=lf
*.json  text    eol=lf
*.yml   text    eol=lf
*.yaml  text    eol=lf
*.xml   text    eol=lf
*.neon  text    eol=lf
*.lock  text    eol=lf

# Force LF In Code Files
*.php   text    eol=lf
*.sh    text    eol=lf
*.js    text    eol=lf
*.cjs   text    eol=lf
*.jsx   text    eol=lf
*.ts    text    eol=lf
*.tsx   text    eol=lf
*.css   text    eol=lf
*.scss  text    eol=lf

# Force LF In Translation Files
*.pot   text    eol=lf
*.po    text    eol=lf
