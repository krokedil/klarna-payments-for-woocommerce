# Managed by krokedil-baseline, changes here are overwritten on the next sync.
# Plugin-specific ignores belong in phpstan-baseline.neon (composer phpstan:baseline).
includes:
  # Included directly: phpstan/extension-installer does not work together with wpify/scoper's nested Composer run.
  - vendor/szepeviktor/phpstan-wordpress/extension.neon
  - phpstan-baseline.neon

parameters:
  level: 5
  phpVersion: 80000
  treatPhpDocTypesAsCertain: false

  paths:
    - klarna-payments-for-woocommerce.php
    - src
    - classes
    - includes
    - templates
    - blocks/src

  # Only excluded from analysis, dependencies/ and vendor/ must still be scanned for symbols.
  excludePaths:
    analyse:
      - vendor (?)
      - node_modules (?)
      - tests (?)
      - blocks/build (?)
      - dependencies (?)
      - assets (?)

  scanDirectories:
    - dependencies

  bootstrapFiles:
    - phpstan-bootstrap.php

  # Scanned, not executed: the WordPress stubs (loaded by szepeviktor/phpstan-wordpress) are not available yet when bootstrap files run.
  scanFiles:
    - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    - vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
    - vendor/php-stubs/woocommerce-subscriptions-stubs/woocommerce-subscriptions-stubs.php
    - phpstan-stubs.php

  dynamicConstantNames:
    - WC_KLARNA_PAYMENTS_VERSION
    - WC_KLARNA_PAYMENTS_MIN_PHP_VER
    - WC_KLARNA_PAYMENTS_MIN_WC_VER
    - WC_KLARNA_PAYMENTS_MAIN_FILE
    - WC_KLARNA_PAYMENTS_PLUGIN_PATH
    - WC_KLARNA_PAYMENTS_PLUGIN_URL
