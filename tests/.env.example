# Copy this file to tests/.env and fill in the blanks.
#
# Both files are gitignored. tests/.env is the one Codeception loads (see
# `params:` in codeception.yml).

# ---------------------------------------------------------------------------
# WordPress test install
# ---------------------------------------------------------------------------

# Where the site is served and where Chrome drives it: the built-in server on
# BUILTIN_SERVER_PORT below. tests/_bootstrap.php pins WP_HOME / WP_SITEURL to it.
WORDPRESS_URL=http://localhost:64942

# The public HTTPS URL the tunnel exposes, which NGROK_DOMAIN below must resolve
# to. Only Klarna uses it; see tests/_mu-plugins/01-klarna-public-url.php.
KP_WORDPRESS_URL=https://<name>.<subdomain>.ngrok.io

# WPLoader's site domain, which it also boots WordPress with as HTTP_HOST. Keep it
# local: the public host there reads as tunnel traffic in a CLI boot.
WORDPRESS_DOMAIN=localhost

WORDPRESS_DB_URL=sqlite://%codecept_root_dir%/tests/_wordpress/data/db.sqlite
WORDPRESS_TABLE_PREFIX=wp_
TEST_TABLE_PREFIX=test_
WORDPRESS_ROOT_DIR=tests/_wordpress

WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=password
WORDPRESS_ADMIN_PATH=/wp-admin

# ---------------------------------------------------------------------------
# Local processes
# ---------------------------------------------------------------------------

BUILTIN_SERVER_PORT=64942
CHROMEDRIVER_HOST=127.0.0.1
CHROMEDRIVER_PORT=16159

# ---------------------------------------------------------------------------
# ngrok
# ---------------------------------------------------------------------------

# Value passed to `ngrok http --domain=<this> ...`.
# Supports custom subdomains using `<name>.internal` format, which is not the
# public URL. The two are coupled by the team ngrok config; readiness in
# NgrokController is matched against KP_WORDPRESS_URL above.
NGROK_DOMAIN=<name>.internal

# Auth token from https://dashboard.ngrok.com/get-started/your-authtoken.
NGROK_AUTHTOKEN=

# ---------------------------------------------------------------------------
# Klarna test credentials (Sweden, test mode)
# ---------------------------------------------------------------------------
#
# Injected into the gateway's settings option by
# tests/_mu-plugins/02-klarna-test-credentials.php at runtime, so KP's
# `is_available()` passes the country/credentials check on the checkout page.
#
# Pull these from a Klarna test merchant account. SE is the only region the
# MVP exercises; add KLARNA_TEST_MID_<region> + KLARNA_TEST_SECRET_<region>
# pairs as the suite grows.

KLARNA_TEST_MID_SE=
KLARNA_TEST_SECRET_SE=
