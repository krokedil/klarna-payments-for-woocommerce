# Klarna playground (test) credentials for the WP Playground dev environment.
# Preferred: put the values in the central ~/.config/krokedil-playground/.env
# (shared by every plugin checkout/worktree; stub the names with
# `pnpm exec krokedil-playground credentials`). Copying this file to a
# gitignored .env here works too and overrides the central file per repo.
# Values come from portal.playground.klarna.com.
KP_TEST_MERCHANT_ID_SE=
KP_TEST_SHARED_SECRET_SE=
KP_TEST_CLIENT_ID_SE=
