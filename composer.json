{
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.3",
    "php-stubs/woocommerce-stubs": "^10.5.0",
    "wpify/scoper": "3.1.3",
    "pronamic/wp-documentor": "1.3.2"
  },
  "config": {
    "platform": {
      "php": "7.4"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "wpify/scoper": true
    }
  },
  "autoload": {
    "psr-4": {
      "Krokedil\\Klarna\\": "src/"
    }
  },
  "extra": {
    "wpify-scoper": {
      "prefix": "KrokedilKlarnaPaymentsDeps",
      "folder": "dependencies",
      "autorun": true,
      "globals": [
        "wordpress",
        "woocommerce"
      ]
    }
  },
  "minimum-stability": "dev",
  "scripts": {
    "get-changelog": "bash .github/scripts/new-version.sh",
    "update-version": "bash .github/scripts/new-version.sh update",
    "create-changelog": "bash .github/scripts/new-changelog.sh",
    "pre-release-check": [
      "bash .github/scripts/check-changelog-master.sh",
      "bash .github/scripts/check-version-and-compat.sh"
    ],
    "lint": "vendor/bin/phpcs . --standard=phpcs.xml --extensions=php -q",
    "lint:fix": "vendor/bin/phpcbf . --standard=phpcs.xml --extensions=php -q",
    "lint:changes": "git diff --name-only HEAD~1 | grep '\\.php$' | xargs vendor/bin/phpcs --standard=phpcs.xml --extensions=php -q",
    "lint:fix:changes": "git diff --name-only HEAD~1 | grep '\\.php$' | xargs vendor/bin/phpcbf --standard=phpcs.xml --extensions=php -q",
    "doc:hooks": "vendor/bin/wp-documentor parse . --exclude=src/DeprecatedHooks.php --exclude=docs --exclude=tests --exclude=vendor --exclude=node_modules --exclude=languages --exclude=assets --exclude=dependencies --format=markdown --type=filters --output=docs/hooks.md --relative=docs --prefix=klarna_ --template=docs/template.php"
  }
}
