<?xml version="1.0"?>
<ruleset name="Krokedil Coding Standards">
    <description>Krokedil baseline PHP_CodeSniffer ruleset. Managed by krokedil-baseline, changes here are overwritten on the next sync.</description>

    <!-- Exclude dependencies, build output and tooling from all rules -->
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/dependencies/*</exclude-pattern>
    <exclude-pattern>*/blocks/build/*</exclude-pattern>
    <exclude-pattern>*/docs/*</exclude-pattern>
    <exclude-pattern>*/kernl-update-checker/*</exclude-pattern>
    <exclude-pattern>*/tmp-*/*</exclude-pattern>

    <!-- Exclude the tests folder -->
    <exclude-pattern>tests/*</exclude-pattern>

    <!-- Set minimum supported WordPress version and PHP test version -->
    <config name="minimum_supported_wp_version" value="6.7" />
    <config name="testVersion" value="7.4-" />

    <!-- WooCommerce Core standard: WordPress, PHPCompatibilityWP and the WooCommerce sniffs -->
    <rule ref="WooCommerce-Core" />

    <!-- Enforce the correct text-domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="klarna-payments-for-woocommerce" />
                <element value="woocommerce" />
            </property>
        </properties>
    </rule>

    <!-- Make the WooCommerce capabilities known to the capability sniff, which only knows the WordPress core ones -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="manage_woocommerce" />
                <element value="pay_for_order" />
            </property>
        </properties>
    </rule>

    <!-- Remove WordPress.Files.FileName.InvalidClassFileName checks to allow for PSR-4 naming convention -->
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <exclude-pattern>src/</exclude-pattern>
    </rule>

    <!-- Remove WordPress.Files.FileName.NotHyphenatedLowercase checks to allow for PSR-4 naming convention -->
    <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
        <exclude-pattern>src/</exclude-pattern>
    </rule>

    <!-- Remove need for package tag in file block comments -->
    <rule ref="Squiz.Commenting.FileComment.MissingPackageTag">
        <exclude-pattern>src/</exclude-pattern>
    </rule>

    <!-- Remove need for file comment -->
    <rule ref="Squiz.Commenting.FileComment.Missing">
        <exclude-pattern>src/</exclude-pattern>
    </rule>

    <!-- Allow the usage of shorthand arrays -->
    <rule ref="Universal.Arrays.DisallowShortArraySyntax.Found">
        <exclude-pattern>src/</exclude-pattern>
    </rule>
</ruleset>
