{
  "require": {
    "php": ">=7.4",
    "krokedil/wp-api": "^1.0",
    "krokedil/woocommerce": "^1.8.0",
    "krokedil/support": "1.0.3",
    "krokedil/settings-page": "1.3.4"
  },
  "config": {
    "platform-check": false,
    "platform": {
      "php": "8.0"
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:krokedil/wp-api.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:krokedil/woocommerce.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:krokedil/support.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:krokedil/settings-page.git"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}
